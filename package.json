{
  "name": "youtube-knowledge-mcp",
  "version": "2.0.2",
  "description": "MCP Server for extracting and managing YouTube video knowledge",
  "author": "teobouancheau",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teobouancheau/youtube-knowledge-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/teobouancheau/youtube-knowledge-mcp/issues"
  },
  "homepage": "https://github.com/teobouancheau/youtube-knowledge-mcp#readme",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "youtube",
    "transcript",
    "knowledge-management",
    "claude",
    "ai"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "youtube-knowledge-mcp": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod 755 dist/cli.js",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "start:http": "node dist/cli.js --http",
    "clean": "rm -rf dist coverage",
    "rebuild": "npm run clean && npm run build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage",
    "prepare": "husky",
    "prepublishOnly": "npm run rebuild && npm run validate"
  },
  "files": [
    "dist"
  ],
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "execa": "^10.0.1",
    "express": "^5.0.1",
    "webvtt-parser": "^2.2.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/webvtt-parser": "^2.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
