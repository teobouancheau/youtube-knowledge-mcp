# Every setting the server reads. All optional; copy to .env and uncomment what you need.
# The README's "Environment variables" table explains each one, and a test keeps the three in step.

# --- HTTP transport ---------------------------------------------------------
# MCP_AUTH_TOKEN=            # required to listen beyond loopback; generate with: openssl rand -hex 32
# MCP_BIND_HOST=127.0.0.1    # 0.0.0.0 inside a container
# MCP_ALLOW_UNAUTHENTICATED=false
# MCP_ALLOWED_HOSTS=         # comma-separated Host allowlist
# MCP_ALLOWED_ORIGINS=       # comma-separated Origin allowlist
# MCP_TRUST_PROXY=false      # true, false, or the number of proxy hops
# MCP_PUBLIC_URL=            # https://mcp.example.com
# MCP_MAX_BODY_BYTES=1048576
# MCP_MODE=                  # http selects the HTTP transport when no --http flag is given
# PORT=3000
# MCP_RATE_LIMIT=60
# MCP_RATE_WINDOW_MS=60000
# MCP_SESSION_IDLE_MS=1800000
# MCP_MAX_SESSIONS=1000

# --- yt-dlp ------------------------------------------------------------------
# YOUTUBE_MCP_MAX_CONCURRENCY=3
# YOUTUBE_MCP_TRANSCRIPT_TTL_MS=2592000000

# How long a per-video stats read stays cached. Counts move constantly, so a
# day is already generous; 0 disables expiry.
# YOUTUBE_MCP_STATS_TTL_MS=86400000
# YOUTUBE_MCP_COOKIES_FROM_BROWSER=   # brave, chrome, chromium, edge, firefox, opera, safari, vivaldi, whale
# YOUTUBE_MCP_COOKIES_FILE=           # a cookies file inside your home directory
# YOUTUBE_MCP_PROXY=                  # socks5h://127.0.0.1:1080
# YOUTUBE_MCP_SLEEP_REQUESTS_S=       # seconds between yt-dlp's own requests
