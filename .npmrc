# Fail installation when a dependency requires a newer Node than this package
# declares in `engines`, instead of installing happily and crashing at runtime.
#
# This is not hypothetical: execa 10 requires Node >= 22 while this package
# supports >= 20, and npm installed it without complaint. The break only showed
# up as `TEXT_ENCODINGS.union is not a function` from deep inside execa, on the
# one CI job that runs the oldest supported Node.
engine-strict=true
